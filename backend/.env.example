# Copy file ini jadi ".env" lalu isi sesuai environment lu.

# Development (default kalau nggak diisi, boleh dikosongin):
# DATABASE_URL=sqlite:///./statlyze.db

# Production (contoh Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/statlyze

# WAJIB diisi sendiri pas production -- jangan pakai nilai default di kode.
# Generate string acak, misal lewat: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-ini-dengan-string-acak-yang-panjang

# Opsional, cuma perlu diisi pas deploy ke hosting (bukan buat lokal).
# Alamat frontend production, dipisah koma kalau lebih dari satu.
# ALLOWED_ORIGINS=https://statlyze-frontend.up.railway.app
